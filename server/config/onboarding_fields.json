{
  "_comment": "Single source of truth for the onboarding wizard AND the scoring inputs. Replace fields here to change the app; no other file needs editing.",
  "steps": [
    {
      "id": "identity",
      "label": { "en": "Your organisation", "fr": "Votre organisation" },
      "hint": { "en": "Legal identity — used for eligibility gates and generated documents.", "fr": "Identité juridique — utilisée pour l'éligibilité et les documents générés." },
      "fields": [
        { "id": "org_name", "type": "text", "required": true,
          "label": { "en": "Organisation name", "fr": "Nom de l'organisation" },
          "placeholder": { "en": "Les Paniers Solidaires", "fr": "Les Paniers Solidaires" } },
        { "id": "legal_status", "type": "select", "required": true,
          "label": { "en": "Legal status", "fr": "Statut juridique" },
          "options": [
            { "value": "association_1901", "label": { "en": "Association (loi 1901)", "fr": "Association loi 1901" } },
            { "value": "fondation", "label": { "en": "Foundation", "fr": "Fondation" } },
            { "value": "fonds_de_dotation", "label": { "en": "Endowment fund", "fr": "Fonds de dotation" } },
            { "value": "cooperative_scic", "label": { "en": "Cooperative (SCIC/SCOP)", "fr": "Coopérative (SCIC/SCOP)" } },
            { "value": "other", "label": { "en": "Other", "fr": "Autre" } }
          ] },
        { "id": "accreditations", "type": "multiselect",
          "label": { "en": "Accreditations held", "fr": "Agréments obtenus" },
          "hint": { "en": "Several French and corporate funders require these.", "fr": "Plusieurs financeurs français et privés les exigent." },
          "options": [
            { "value": "interet_general", "label": { "en": "General interest (intérêt général)", "fr": "Intérêt général" } },
            { "value": "rup", "label": { "en": "Public utility (RUP)", "fr": "Reconnue d'utilité publique (RUP)" } },
            { "value": "esus", "label": { "en": "ESUS accreditation", "fr": "Agrément ESUS" } },
            { "value": "aide_alimentaire", "label": { "en": "Food aid accreditation", "fr": "Habilitation aide alimentaire" } },
            { "value": "jeunesse_education", "label": { "en": "Youth & popular education", "fr": "Jeunesse et éducation populaire" } }
          ] },
        { "id": "siret_rna", "type": "text",
          "label": { "en": "SIRET / RNA number", "fr": "Numéro SIRET / RNA" },
          "placeholder": { "en": "W123456789", "fr": "W123456789" } },
        { "id": "year_founded", "type": "number", "required": true, "min": 1800, "max": 2026,
          "label": { "en": "Year founded", "fr": "Année de création" } },
        { "id": "website", "type": "text",
          "label": { "en": "Website", "fr": "Site internet" },
          "placeholder": { "en": "https://", "fr": "https://" } }
      ]
    },
    {
      "id": "mission",
      "label": { "en": "Mission & beneficiaries", "fr": "Mission et bénéficiaires" },
      "hint": { "en": "Drives thematic matching — the single biggest scoring factor.", "fr": "Détermine la correspondance thématique — le principal facteur de score." },
      "fields": [
        { "id": "cause_areas", "type": "multiselect", "required": true,
          "label": { "en": "Cause areas", "fr": "Domaines d'action" },
          "options": [
            { "value": "food_waste", "label": { "en": "Food waste", "fr": "Gaspillage alimentaire" } },
            { "value": "food_security", "label": { "en": "Food security", "fr": "Sécurité alimentaire" } },
            { "value": "poverty", "label": { "en": "Poverty & precarity", "fr": "Pauvreté et précarité" } },
            { "value": "environment", "label": { "en": "Environment", "fr": "Environnement" } },
            { "value": "climate", "label": { "en": "Climate", "fr": "Climat" } },
            { "value": "circular_economy", "label": { "en": "Circular economy", "fr": "Économie circulaire" } },
            { "value": "social_inclusion", "label": { "en": "Social inclusion", "fr": "Inclusion sociale" } },
            { "value": "employment", "label": { "en": "Employment & integration", "fr": "Emploi et insertion" } },
            { "value": "education", "label": { "en": "Education", "fr": "Éducation" } },
            { "value": "health", "label": { "en": "Health", "fr": "Santé" } },
            { "value": "housing", "label": { "en": "Housing", "fr": "Logement" } },
            { "value": "youth", "label": { "en": "Youth", "fr": "Jeunesse" } },
            { "value": "elderly", "label": { "en": "Elderly", "fr": "Personnes âgées" } },
            { "value": "disability", "label": { "en": "Disability", "fr": "Handicap" } },
            { "value": "gender_equality", "label": { "en": "Gender equality", "fr": "Égalité femmes-hommes" } },
            { "value": "culture", "label": { "en": "Culture", "fr": "Culture" } }
          ] },
        { "id": "mission_statement", "type": "textarea", "required": true, "maxlength": 600,
          "label": { "en": "Mission statement", "fr": "Description de la mission" },
          "hint": { "en": "2–4 sentences. Used verbatim as source material for generated documents.", "fr": "2 à 4 phrases. Utilisé comme source pour les documents générés." },
          "placeholder": { "en": "We recover unsold food from supermarkets and redistribute it…", "fr": "Nous récupérons les invendus alimentaires et les redistribuons…" } },
        { "id": "target_groups", "type": "multiselect",
          "label": { "en": "Who you serve", "fr": "Publics bénéficiaires" },
          "options": [
            { "value": "families", "label": { "en": "Families", "fr": "Familles" } },
            { "value": "children", "label": { "en": "Children", "fr": "Enfants" } },
            { "value": "youth", "label": { "en": "Young people", "fr": "Jeunes" } },
            { "value": "students", "label": { "en": "Students", "fr": "Étudiants" } },
            { "value": "elderly", "label": { "en": "Elderly people", "fr": "Personnes âgées" } },
            { "value": "homeless", "label": { "en": "Homeless people", "fr": "Personnes sans domicile" } },
            { "value": "refugees", "label": { "en": "Refugees & migrants", "fr": "Réfugiés et migrants" } },
            { "value": "unemployed", "label": { "en": "Unemployed people", "fr": "Personnes sans emploi" } },
            { "value": "disabled", "label": { "en": "People with disabilities", "fr": "Personnes en situation de handicap" } },
            { "value": "women", "label": { "en": "Women", "fr": "Femmes" } },
            { "value": "general_public", "label": { "en": "General public", "fr": "Grand public" } }
          ] },
        { "id": "beneficiaries_per_year", "type": "number", "min": 0,
          "label": { "en": "People served per year", "fr": "Bénéficiaires par an" } }
      ]
    },
    {
      "id": "scale",
      "label": { "en": "Size & territory", "fr": "Taille et territoire" },
      "hint": { "en": "Funders set budget bands and geographic limits.", "fr": "Les financeurs fixent des seuils budgétaires et géographiques." },
      "fields": [
        { "id": "annual_budget_eur", "type": "number", "required": true, "min": 0,
          "label": { "en": "Annual budget (EUR)", "fr": "Budget annuel (EUR)" } },
        { "id": "employees_count", "type": "number", "min": 0,
          "label": { "en": "Paid staff", "fr": "Salariés" } },
        { "id": "volunteers_count", "type": "number", "min": 0,
          "label": { "en": "Volunteers", "fr": "Bénévoles" } },
        { "id": "country", "type": "select", "required": true,
          "label": { "en": "Country", "fr": "Pays" },
          "options": [
            { "value": "FR", "label": { "en": "France", "fr": "France" } },
            { "value": "BE", "label": { "en": "Belgium", "fr": "Belgique" } },
            { "value": "ES", "label": { "en": "Spain", "fr": "Espagne" } },
            { "value": "DE", "label": { "en": "Germany", "fr": "Allemagne" } },
            { "value": "IT", "label": { "en": "Italy", "fr": "Italie" } },
            { "value": "other_eu", "label": { "en": "Other EU country", "fr": "Autre pays de l'UE" } }
          ] },
        { "id": "regions", "type": "multiselect",
          "label": { "en": "Regions of operation", "fr": "Régions d'intervention" },
          "options": [
            { "value": "auvergne_rhone_alpes", "label": { "en": "Auvergne-Rhône-Alpes", "fr": "Auvergne-Rhône-Alpes" } },
            { "value": "bourgogne_franche_comte", "label": { "en": "Bourgogne-Franche-Comté", "fr": "Bourgogne-Franche-Comté" } },
            { "value": "bretagne", "label": { "en": "Brittany", "fr": "Bretagne" } },
            { "value": "centre_val_de_loire", "label": { "en": "Centre-Val de Loire", "fr": "Centre-Val de Loire" } },
            { "value": "corse", "label": { "en": "Corsica", "fr": "Corse" } },
            { "value": "grand_est", "label": { "en": "Grand Est", "fr": "Grand Est" } },
            { "value": "hauts_de_france", "label": { "en": "Hauts-de-France", "fr": "Hauts-de-France" } },
            { "value": "ile_de_france", "label": { "en": "Île-de-France", "fr": "Île-de-France" } },
            { "value": "normandie", "label": { "en": "Normandy", "fr": "Normandie" } },
            { "value": "nouvelle_aquitaine", "label": { "en": "Nouvelle-Aquitaine", "fr": "Nouvelle-Aquitaine" } },
            { "value": "occitanie", "label": { "en": "Occitanie", "fr": "Occitanie" } },
            { "value": "pays_de_la_loire", "label": { "en": "Pays de la Loire", "fr": "Pays de la Loire" } },
            { "value": "paca", "label": { "en": "Provence-Alpes-Côte d'Azur", "fr": "Provence-Alpes-Côte d'Azur" } },
            { "value": "outre_mer", "label": { "en": "Overseas territories", "fr": "Outre-mer" } },
            { "value": "national", "label": { "en": "Nationwide", "fr": "National" } },
            { "value": "europe", "label": { "en": "Several EU countries", "fr": "Plusieurs pays de l'UE" } }
          ] }
      ]
    },
    {
      "id": "capacity",
      "label": { "en": "Funding capacity", "fr": "Capacité de financement" },
      "hint": { "en": "Decisive for EU grants, which demand co-financing and heavy reporting.", "fr": "Déterminant pour les subventions européennes (cofinancement et reporting exigeants)." },
      "fields": [
        { "id": "has_audited_accounts", "type": "boolean",
          "label": { "en": "Accounts certified by an auditor", "fr": "Comptes certifiés par un commissaire aux comptes" } },
        { "id": "cofinancing_capacity_pct", "type": "number", "min": 0, "max": 100,
          "label": { "en": "Co-financing capacity (%)", "fr": "Capacité de cofinancement (%)" },
          "hint": { "en": "Share of a project you could fund from your own resources.", "fr": "Part d'un projet finançable sur vos fonds propres." } },
        { "id": "can_report_in_english", "type": "boolean",
          "label": { "en": "Able to apply and report in English", "fr": "Capable de candidater et rapporter en anglais" } },
        { "id": "grant_experience", "type": "select",
          "label": { "en": "Previous grant experience", "fr": "Expérience en financements" },
          "options": [
            { "value": "none", "label": { "en": "None yet", "fr": "Aucune" } },
            { "value": "local", "label": { "en": "Local / regional grants", "fr": "Subventions locales / régionales" } },
            { "value": "national", "label": { "en": "National grants or foundations", "fr": "Subventions nationales ou fondations" } },
            { "value": "eu", "label": { "en": "European grants", "fr": "Subventions européennes" } }
          ] },
        { "id": "has_grant_writer", "type": "boolean",
          "label": { "en": "Someone dedicated to fundraising", "fr": "Personne dédiée à la recherche de fonds" } }
      ]
    },
    {
      "id": "project",
      "label": { "en": "What you need funding for", "fr": "Votre besoin de financement" },
      "hint": { "en": "Used to match grant sizes and to draft your application documents.", "fr": "Utilisé pour calibrer les montants et rédiger vos documents." },
      "fields": [
        { "id": "project_title", "type": "text", "required": true,
          "label": { "en": "Project title", "fr": "Titre du projet" } },
        { "id": "project_description", "type": "textarea", "required": true, "maxlength": 800,
          "label": { "en": "Project description", "fr": "Description du projet" },
          "hint": { "en": "What you'll do, for whom, and the change you expect.", "fr": "Ce que vous ferez, pour qui, et le changement attendu." } },
        { "id": "amount_sought_eur", "type": "number", "required": true, "min": 0,
          "label": { "en": "Amount sought (EUR)", "fr": "Montant recherché (EUR)" } },
        { "id": "project_duration_months", "type": "number", "min": 1, "max": 120,
          "label": { "en": "Project duration (months)", "fr": "Durée du projet (mois)" } }
      ]
    }
  ]
}
